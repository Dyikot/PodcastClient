@inject IJSRuntime JS
@inherits PlayerBase

<div class="layout">
	<audio src="@Source" 
		   @ref="_control"
		   @onloadedmetadata="OnMetadataLoaded"
		   @onended="OnEnded"
		   @onplay="OnPlay"
		   @onpause="OnPause"
		   @ontimeupdate="OnTimeUpdate" />
	<!--Duration slider-->
	<input class="slider sliderThumb" id="durationSlider"
		   type="range"
		   style="background-size: @(CurrentTimePersentage)% 100%;"
		   max="@Duration.TotalSeconds"
		   value="@CurrentTime.TotalSeconds"
		   @oninput="OnCurrentTimeSliderChanged" />
	<div class="controls bg-1" data-canplay="@CanPlay.ToString()">
		<!--Rewind button-->
		<button class="controlButton rewindButton rounded-circle bg-1 hoverable"
				@onclick="OnRewindButtonClick">
			<img src="Controls/AudioPlayer/Replay.svg" />
		</button>
		<!--Play/Pause button-->
		<ToggleButton Class="rounded-circle bg-1 hoverable p-0"
					  CheckedClass="rounded-circle bg-1 hoverable p-0"
					  IsChecked="IsPlaying"
					  OnClick="OnPlayButtonClick">
			<ContentTemplate>
				<img src="Controls/AudioPlayer/Play.svg" width="32" />
			</ContentTemplate>
			<CheckedContentTemplate>
				<img src="Controls/AudioPlayer/Pause.svg" width="32" />
			</CheckedContentTemplate>
		</ToggleButton>
		<!--Forward button-->
		<button class="controlButton rewindButton rounded-circle bg-1 hoverable"
				@onclick="OnForwardButtonClick">
			<img src="Controls/AudioPlayer/Forward.svg"  />
		</button>
		<!--Duration panel-->
		<div class="durationPanel">
			<span>@CurrentTime.ToString(TimeFormat)</span>
			<span>/</span>
			<span>@Duration.ToString(TimeFormat)</span>
		</div>
		<!--Mute button-->
		<ToggleButton Class="controlButton rounded-circle bg-1 hoverable ms-auto"
					  CheckedClass="controlButton rounded-circle bg-1 hoverable ms-auto"
					  IsChecked="IsMute"
					  OnClick="OnMuteButtonClick">
			<ContentTemplate>
				<img src="Controls/AudioPlayer/VolumeOn.svg"  />
			</ContentTemplate>
			<CheckedContentTemplate>
				<img src="Controls/AudioPlayer/VolumeOff.svg"  />
			</CheckedContentTemplate>
		</ToggleButton>
		<!--Volume slider-->
		<input class="slider rounded-2" id="volumeSlider"
			   type="range"
			   style="background-size: @(VolumePersentage)% 100%;"
			   max="1"
			   min="0"
			   step="0.025"
			   value="@Volume"
			   @oninput="OnVolumeSliderChanged" />
		<!--Speed selector-->
		<ComboBox TItem="double"
				  SelectedItem="PlaySpeed"
				  Items="PlaySpeedOptions"
				  SelectionChanged="OnSpeedOptionSelect"
				  DropDownPosition="DropDownPosition.Top"
				  ButtonClass="controlButton rounded-circle bg-1 hoverable"
				  DropDownClass="playSpeed-dropDown"
				  Context="context">
			<ButtonContentTemplate>
				<img src="Controls/AudioPlayer/PlaySpeed.svg"  />
			</ButtonContentTemplate>
			<ItemTemplate>
				@GetSpeedOptionLabel(context)
			</ItemTemplate>
		</ComboBox>
	</div>	
</div>
