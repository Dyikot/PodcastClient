@inject IJSRuntime JS
@inherits PlayerBase

<div class="playerLayout d-flex flex-column justify-content-center align-items-stretch">
	<audio src="@Source" 
		   @ref="_control"
		   @onloadedmetadata="OnMetadataLoaded"
		   @onended="OnEnded"
		   @onplay="OnPlay"
		   @onpause="OnPause"
		   @ontimeupdate="OnTimeUpdate" />
	<!--Duration slider-->
	<input class="slider sliderThumb"
		   type="range"
		   style="background-size: @(DurationPersentage)% 100%;"
		   max="@Duration.TotalSeconds"
		   value="@CurrentTime.TotalSeconds"
		   @oninput="OnCurrentTimeSliderChanged" />
	<div class="bg-1 flex-grow-1 px-4 d-flex align-items-center gap-1" data-CanPlay="@CanPlay.ToString()">
		<!--Rewind button-->
		<button class="btn bg-1 hoverable"
				@onclick="OnRewindButtonClick">
			<img src="Controls/AudioPlayer/Replay.svg" />
		</button>
		<!--Play/Pause button-->
		<ToggleButton Class="btn bg-1 hoverable px-2"
					  CheckedClass="btn bg-1 hoverable px-2"
					  IsChecked="IsPlaying"
					  OnClick="OnPlayButtonClick">
			<ContentTemplate>
				<img src="Controls/AudioPlayer/Play.svg" width="36" />
			</ContentTemplate>
			<CheckedContentTemplate>
				<img src="Controls/AudioPlayer/Pause.svg" width="36" />
			</CheckedContentTemplate>
		</ToggleButton>
		<!--Forward button-->
		<button class="btn bg-1 hoverable"
				@onclick="OnForwardButtonClick">
			<img src="Controls/AudioPlayer/Forward.svg"  />
		</button>
		<!--Duration panel-->
		<div class="d-flex justify-content-center align-items-center gap-1"
			 style="width: 160px">
			<span id="duration-played">@CurrentTime.ToString(TimeFormat)</span>
			<span>/</span>
			<span id="duration-total">@Duration.ToString(TimeFormat)</span>
		</div>
		<!--Mute button-->
		<ToggleButton Class="btn bg-1 hoverable ms-auto"
					  CheckedClass="btn bg-1 hoverable  ms-auto"
					  IsChecked="IsMute"
					  OnClick="OnMuteButtonClick">
			<ContentTemplate>
				<img src="Controls/AudioPlayer/VolumeOn.svg"  />
			</ContentTemplate>
			<CheckedContentTemplate>
				<img src="Controls/AudioPlayer/VolumeOff.svg"  />
			</CheckedContentTemplate>
		</ToggleButton>
		<!--Volume slider-->
		<input class="slider rounded-2"
			   type="range"
			   style="background-size: @(VolumePersentage)% 100%;"
			   max="1"
			   min="0"
			   step="0.025"
			   value="@Volume"
			   @oninput="OnVolumeSliderChanged" />
		<!--Speed selector-->
		<ComboBox TItem="double"
				  SelectedItem="PlaySpeed"
				  Items="PlaySpeedOptions"
				  SelectionChanged="OnSpeedOptionSelect"
				  DropDownPosition="DropDownPosition.Top"
				  ButtonClass="btn bg-1 hoverable"
				  DropDownClass="playSpeed-dropDown"
				  Context="context">
			<ButtonContentTemplate>
				<img src="Controls/AudioPlayer/PlaySpeed.svg"  />
			</ButtonContentTemplate>
			<ItemTemplate>
				@GetSpeedOptionLabel(context)
			</ItemTemplate>
		</ComboBox>
	</div>	
</div>
