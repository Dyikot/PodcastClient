@inject IJSRuntime JS
@typeparam TItem

<div class="position-relative" @onfocusout="OnLostFocus">
	<button class="comboBox-button @ButtonClass" @onclick="OnButtonClick">
		@ButtonContentTemplate!(SelectedItem)
	</button>
	@if(IsDropDownOpen)
	{
		<div class="comboBox-dropDown @DropDownClass"
			 data-DropDownPosition="@DropDownPosition"
			 @onmouseenter="OnMouseEnter"
			 @onmouseleave="OnMouseLeave">
			@foreach (var itemPresenter in _itemPrenseters)
			{
				<button class="comboBox-item @ItemClass"
						@onclick="itemPresenter.OnClick"
						data-IsSelected="@itemPresenter.IsSelected.ToString()">
					@ItemTemplate(itemPresenter.Item)
				</button>
			}
		</div>
	}
</div>
