@typeparam TValue

<div id="speed-layout">
	<button class="@ButtonClass" @onclick="OnButtonClick">
		@ChildContent
	</button>
	@if (_isVisible)
	{
		<div id="items-panel"
			 class="@PanelClass"
			 @onfocusout="OnItemFocusLost"
			 @onmouseenter="() => _isOverPanel = true"
			 @onmouseleave="() => _isOverPanel = false">
			@foreach((TValue value, string content) in ValueContentDictionary)
			{
				<button class="@ItemClass"
						@ref="_items[value]"
						@onclick="() => OnItemClick(value)">
					@content
				</button>
			}
		</div>
	}
</div>
