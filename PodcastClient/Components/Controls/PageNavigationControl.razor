@inject NavigationManager NavigationManager

@if(PageAmount > 1)
{    
    <ul class="pagination @Class">
        @if(Page > 3)
        {
            <li class="page-item">
                <a class="page-link" href="@FirstPageUri">
                    @Resource.ToFirst
                </a>
            </li>
        }
        @foreach(var page in Enumerable.Range(Start, Count))
        {
            @PageNumberView(page)
        }
        @if(Page < PageAmount)
        {
            <li class="page-item">
                <a class="page-link" href="@NextPageUri">
                    @Resource.NextPage
                </a>
            </li>
        }
    </ul>
}

