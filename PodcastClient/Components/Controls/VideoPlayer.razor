@inject IJSRuntime JS
@inherits PlayerBase

<figure id="video-player">
	<video src="@Source"
		   tabindex="0"
		   @ref="_control"
		   @onloadedmetadata="OnMetadataLoaded"
		   @onended="OnEnded"
		   @onplay="OnPlay"
		   @onpause="OnPause"
		   @ontimeupdate="OnTimeUpdate"
		   @onclick="OnPlayButtonClick"
		   @onkeydown="OnKeyDown"
		   @ondblclick="OnFullscreenButtonClick" />
	@if (!CanPlay)
	{
		<div class="position-absolute top-50 start-50 translate-middle">
			<div class="spinner-border text-warning" role="status">
				<span class="visually-hidden">Loading...</span>
			</div>
		</div>
	}
	<div id="controls">
		<!--Duration slider-->
		<input class="slider sliderThumb" id="durationSlider"
			   type="range"
			   style="background-size: @(CurrentTimePersentage)% 100%;"
			   max="@Duration.TotalSeconds"
			   value="@CurrentTime.TotalSeconds"
			   @oninput="OnCurrentTimeSliderChanged" />
		<!--Buttons-->
		<div id="controls-buttons">
			<!--Rewind button-->
			<button class="controlButton rounded-circle rewindButton"
					@onclick="OnRewindButtonClick">
				<img src="Controls/VideoPlayer/Replay.svg" />
			</button>
			<!--Play/Pause button-->
			<ToggleButton Class="controlButton rounded-circle p-0"
						  CheckedClass="controlButton rounded-circle p-0"
						  IsChecked="IsPlaying"
						  OnClick="OnPlayButtonClick">
				<ContentTemplate>
					<img src="Controls/VideoPlayer/Play.svg" width="32" />
				</ContentTemplate>
				<CheckedContentTemplate>
					<img src="Controls/VideoPlayer/Pause.svg" width="32" />
				</CheckedContentTemplate>
			</ToggleButton>
			<!--Forward button-->
			<button class="controlButton rounded-circle"
				    @onclick="OnForwardButtonClick">
				<img src="Controls/VideoPlayer/Forward.svg"  />
			</button>
			<!--Duration panel-->
			<div id="duraionPanel">
				<span>@CurrentTime.ToString(TimeFormat)</span>
				<span>/</span>
				<span>@Duration.ToString(TimeFormat)</span>
			</div>
			<!--Mute button-->
			<ToggleButton Class="controlButton rounded-circle ms-auto"
						  CheckedClass="controlButton rounded-circle ms-auto"
						  IsChecked="IsMute"
						  OnClick="OnMuteButtonClick">
				<ContentTemplate>
					<img src="Controls/VideoPlayer/VolumeOn.svg"  />
				</ContentTemplate>
				<CheckedContentTemplate>
					<img src="Controls/VideoPlayer/VolumeOff.svg"  />
				</CheckedContentTemplate>
			</ToggleButton>
			<!--Volume slider-->
			<input class="slider rounded-2" id="volumeSlider"
				   type="range"
				   style="background-size: @(VolumePersentage)% 100%"
				   max="1"
				   min="0"
				   step="0.025"
				   value="@Volume"
				   @oninput="OnVolumeSliderChanged" />
			<!--Speed selector-->
			<ComboBox TItem="double"
					  SelectedItem="PlaySpeed"
					  SelectionChanged="OnSpeedOptionSelect"
					  DropDownPosition="DropDownPosition.Top"
					  ButtonClass="controlButton rounded-circle"
					  DropDownClass="speedDropDown mb-3"
					  Items="PlaySpeedOptions"
					  Context="context">
				<ButtonContentTemplate>
					<img src="Controls/VideoPlayer/PlaySpeed.svg" />
				</ButtonContentTemplate>
				<ItemTemplate>
					@GetSpeedOptionLabel(context)
				</ItemTemplate>
			</ComboBox>
			<!--Fullscreen button-->
			<button class="controlButton rounded-circle fullscreenButton"
					@onclick="OnFullscreenButtonClick" />
		</div>
	</div>
</figure>