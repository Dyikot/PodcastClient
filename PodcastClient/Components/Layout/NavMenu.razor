@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<nav class="navMenu">
    <NavLink class="navItem" href="" Match="NavLinkMatch.All">
        <img src="Navigation/Home.svg" />
        <span>@Resource.Home</span>
    </NavLink>
    <AuthorizeView>
        <NavLink class="navItem" href="library">
            <img src="Navigation/Library.svg" />
            <span>@Resource.Library</span>
        </NavLink>
        <NavLink class="navItem" href="new-episodes">
            <img src="Navigation/MusicQueue.svg" />
            <span>@Resource.NewEpisodes</span>
        </NavLink>
    </AuthorizeView>
    <div class="authItem" @onfocusout="OnAuthMenuFocusLost">
        <button class="authButton" @onclick="OnAuthButtonClick">
            <img src="Navigation/Account.svg" />
            <span>@Resource.Account</span>
        </button>
        @if (_isAuthMenuOpen)
        {
            <div class="authMenu bg-1 rounded-2 border-main"
                 @onmouseenter="OnAuthMenuMouseEnter"
                 @onmouseleave="OnAuthMenuMouseLeave">
                <button class="defaultButton linkButton bg-1 hoverable rounded-2"
                        @onclick="OnSettingsClick">
                    <img src="Navigation/Settings.svg" />
                    <span>@Resource.Settings</span>
                </button>
                <AuthorizeView>
                    <Authorized>
                        <button class="defaultButton bg-1 hoverable rounded-2" @onclick="LogOut">
                            <img src="Navigation/Logout.svg" />
                            <span>@Resource.SignOut</span>
                        </button>
                    </Authorized>
                    <NotAuthorized>
                        <button class="defaultButton bg-1 hoverable rounded-2" @onclick="LogIn">
                            <img src="Navigation/Login.svg" />
                            <span>@Resource.NavMenuSignIn</span>
                        </button>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        }
    </div>
</nav>