@page "/podcast/{podcastId:int}/episode/{episodeNumber:int}"
@inject UserContext UserContext
@inject MediaService MediaService
@inject IStringLocalizer<Resources.Resource> Localizer
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory

<PageTitle>@(Episode?.Title ?? Resource.EpisodeNotFound)</PageTitle>

<div class="h-100 d-flex flex-column align-items-center gap-3">
	@if(Episode == null)
	{
		<h2 class="m-2 align-self-start">@Resource.EpisodeNotFound</h2>
	}
	else
	{
		<!--Header-->
		<div class="layout mainLayout">
			<!--Icon-->
			<img src="@Episode!.IconSource" class="icon rounded-2" />
			<!--About-->
			<div class="d-flex flex-column">
				<span class="fontSize-2 fw-medium">@Episode.Title</span>
				<span>@PodcastTitle</span>
				<div class="mt-2 d-flex gap-2 fontSize-r1">
					<div class="d-flex align-items-center gap-2">
						<img src="Episode/Calendar.svg" width="16" />
						<span>@Episode.ReleaseDate.ToLocalizedString(Localizer)</span>
					</div>
					<div class="d-flex align-items-center gap-2">
						<img src="Episode/Clock.svg" width="16" />
						<span>@Episode.Duration.ToLocalizedString(Localizer)</span>
					</div>
				</div>
				<div class="linkContainer">
					<a class="btn bg-0 hoverable border-main" href="@PodcastHref">
						<img src="Episode/Podcast.svg" />
						<span>@Resource.PodcastPage</span>
					</a>
					<a class="btn bg-0 hoverable border-main" href="@Episode.Source" target="_blank">
						<img src="Episode/Link.svg" />
						<span>@Resource.Source</span>
					</a>
				</div>
			</div>
		</div>
		<!--Description-->
		<div class="mainLayout order-2">@Description</div>
		<!--Player-->
		switch (Episode.Type)
		{
			case EpisodeType.Audio:
				<AudioPlayer Source="@Episode.ContentSource"
							 Duration="@Episode.Duration"
							 @bind-CurrentTime="EpisodePlayback!.Played"
							 @bind-Volume="MediaService.AudioVolume"
							 @bind-PlaySpeed="MediaService.AudioSpeed"
							 OnPlay="OnPlay"
							 OnPause="OnPause"
							 Ended="OnEnded" />
				break;
			case EpisodeType.Video:
				<div class="d-flex mainLayout order-1">
					<VideoPlayer Source="@Episode.ContentSource"
								 Duration="@Episode.Duration"
								 @bind-CurrentTime="EpisodePlayback!.Played"
								 @bind-Volume="MediaService.VideoVolume"
								 @bind-PlaySpeed="MediaService.VideoSpeed"
								 OnPlay="OnPlay"
								 OnPause="OnPause"
								 Ended="OnEnded" />
				</div>
				break;
		}
	}
</div>
