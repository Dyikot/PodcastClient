@page "/"
@inject UserContext UserContext
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@using PodcastClient.Components.Pages.Search

<PageTitle>@Resource.Home</PageTitle>

<style>
	.categoryButton {
		width: 250px;
		padding: .5rem;
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: .75rem;
		text-decoration: none;
		color: var(--fg-main);
	}
</style>

<div class="p-3 d-flex flex-column gap-5">
	<!--Search-->
	<a href="/search" class="bg-0 seacrhBar rounded-5 fg-secondary fontSize-3">
		<img src="Home/Search.svg" />
		<span>@Resource.Search</span>
	</a>
	<!--New episodes-->
	<AuthorizeView>
		<div class="card">
			<div class="card-header fontSize-2">
				@Resource.NewEpisodes
			</div>
			<div class="card-body">
				@if(NewEpisodes?.Count > 0)
				{
					<div class="d-flex flex-column gap-2">
						@foreach(var episode in NewEpisodes.Take(3))
						{
							<EpisodeView DataContext="episode" />
						}
						@if(NewEpisodes.Count > 3)
						{
							<NavLink href="new-episodes" class="btn bg-1 hoverable">
								@Resource.MoreEpisodes
							</NavLink>							
						}
					</div>
				}
				else
				{
					<div class="card-text fg-secondary text-center">
						@Resource.NoNewEpisodes
					</div>
				}
			</div>
		</div>
	</AuthorizeView>
	<!--Popular-->
	<!--New-->
	<!--Categories-->
	<div class="d-flex flex-column gap-2">
		<span class="fontSize-4 fw-semibold">@Resource.ExploreByCategory</span>
		<div class="d-flex flex-wrap gap-3">
			@CategoryView(Resource.Arts, "category/arts", "Home/Palette.svg")
			@CategoryView(Resource.Business, "category/business", "Home/Business.svg")
			@CategoryView(Resource.Comedy, "category/comedy", "Home/Comedy.svg")
			@CategoryView(Resource.Education, "category/education", "Home/School.svg")
			@CategoryView(Resource.Fiction, "category/fiction", "Home/Book.svg")
			@CategoryView(Resource.Government, "category/government", "Home/Government.svg")
			@CategoryView(Resource.History, "category/history", "Home/Book2.svg")
			@CategoryView(Resource.HealthAndFitness, "category/health-fitness", "Home/Health.svg")
			@CategoryView(Resource.KidsAndFamily, "category/kids-family", "Home/Family.svg")
			@CategoryView(Resource.Leisure, "category/leisure", "Home/Leisure.svg")
			@CategoryView(Resource.Music, "category/music", "Home/Music.svg")
			@CategoryView(Resource.News, "category/news", "Home/News.svg")
			@CategoryView(Resource.ReligionAndSpirituality, "category/religion-spirituality", "Home/Religion.svg")
			@CategoryView(Resource.Science, "category/science", "Home/Science.svg")
			@CategoryView(Resource.SocietyAndCulture, "category/society-culture", "Home/Building.svg")
			@CategoryView(Resource.Sports, "category/sports", "Home/Sports.svg")
			@CategoryView(Resource.Technology, "category/technology", "Home/Technology.svg")
			@CategoryView(Resource.TrueCrime, "category/true-crime", "Home/Police.svg")
			@CategoryView(Resource.TvAndFilm, "category/tv-film", "Home/TV.svg")
		</div>
	</div>
</div>
