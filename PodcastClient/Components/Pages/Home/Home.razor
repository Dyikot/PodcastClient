@page "/"
@inject IJSRuntime JS
@inject UserContext UserContext
@inject CategoriesService CategoriesService
@inject IStringLocalizer<Resource> Localizer
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@using PodcastClient.Components.Pages.Search

<PageTitle>@Resource.Home</PageTitle>

<div class="p-3 d-flex flex-column gap-5">
	<!--Search-->
	<a href="/search" class="bg-0 seacrhBar rounded-5 fg-secondary fontSize-3">
		<img src="Home/Search.svg" />
		<span>@Resource.Search</span>
	</a>
	<!--New episodes-->
	<AuthorizeView>
		<div class="card">
			<div class="card-header fontSize-2">
				@Resource.NewEpisodes
			</div>
			<div class="card-body">
				@if(NewEpisodes?.Count > 0)
				{
					<div class="d-flex flex-column gap-2">
						@foreach(var episode in NewEpisodes.Take(3))
						{
							<EpisodeView DataContext="episode" />
						}
						@if(NewEpisodes.Count > 3)
						{
							<NavLink href="new-episodes" class="btn bg-1 hoverable">
								@Resource.MoreEpisodes
							</NavLink>							
						}
					</div>
				}
				else
				{
					<div class="card-text fg-secondary text-center">
						@Resource.NoNewEpisodes
					</div>
				}
			</div>
		</div>
	</AuthorizeView>
	<!--Popular-->
	<div class="d-flex flex-column gap-2">
		<span class="fontSize-4 fw-semibold">@Resource.PopularPodcasts</span>
		<Carousel Class="podcastsContainer" @ref="_popularPodcasts">
			<ContentTemplate>
				@foreach (var podcast in PopularPodcasts)
				{
					<PodcastView Podcast="podcast" />
				}
			</ContentTemplate>
		</Carousel>
	</div>
	<!--New-->
	<div class="d-flex flex-column gap-2">
		<span class="fontSize-4 fw-semibold">@Resource.NewPodcasts</span>
		<Carousel Class="podcastsContainer" @ref="_newPodcasts">
			<ContentTemplate>
				@foreach (var podcast in NewPodcasts)
				{
					<PodcastView Podcast="podcast" />
				}
			</ContentTemplate>
		</Carousel>
	</div>
	<!--Categories-->
	<div class="d-flex flex-column gap-2">
		<span class="fontSize-4 fw-semibold">@Resource.ExploreByCategory</span>
		<div class="d-flex flex-wrap gap-3">
			@foreach(var category in Categories)
			{
				<a href="@category.Uri" class="bg-1 hoverable rounded-2 categoryButton">
					<img src="@category.ImageSource" />
					<span>@category.LocalizedName</span>
				</a>
			}
		</div>
	</div>
</div>
