@page "/"
@inject IJSRuntime JS
@inject UserContext UserContext
@inject CategoriesService CategoriesService
@inject IStringLocalizer<Resource> Localizer
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@using PodcastClient.Components.Pages.Search

<PageTitle>@Resource.Home</PageTitle>

<div class="p-3 d-flex flex-column gap-5">
	<!--Search-->
	<a href="search" class="bg-0 seacrhBar rounded-5 fg-main-3 fontSize-3">
		<img src="Home/Search.svg" />
		<span>@Resource.Search</span>
	</a>
	<!--New episodes-->
	<AuthorizeView>
		<div class="card">
			<div class="card-header fontSize-2">
				@Resource.NewEpisodes
			</div>
			<div class="card-body">
				@if(NewEpisodes?.Count > 0)
				{
					<div class="d-flex flex-column gap-2">
						@foreach(var episode in NewEpisodes.Take(3))
						{
							<EpisodeView DataContext="episode" />
						}
						@if(NewEpisodes.Count > 3)
						{
							<NavLink href="new-episodes" class="linkButton bg-1 hoverable rounded-2">
								@Resource.MoreEpisodes
							</NavLink>							
						}
					</div>
				}
				else
				{
					<div class="card-text fg-main-3 text-center">
						@Resource.NoNewEpisodes
					</div>
				}
			</div>
		</div>
	</AuthorizeView>
	<!--Popular-->
	<div class="d-flex flex-column gap-2">
		<div class="podcastsHeader">
			<span class="header-3">@Resource.PopularPodcasts</span>
			<div class="podcastsNavigation">
				<button class="p-1 bg-0 rounded-circle carouselButton"
						id="popularLeftButton">
					<img src="Home/ArrowLeft.svg" />
				</button>
				<button class="p-1 bg-0 rounded-circle carouselButton"
						id="popularRightButton">
					<img src="Home/ArrowRight.svg" />
				</button>
			</div>
		</div>
		<Carousel Class="podcastsContainer"
				  Items="PopularPodcasts"
				  LeftButtonId="popularLeftButton"
				  RightButtonId="popularRightButton"
				  Context="podcast">
			<ItemTemplate>
				<PodcastView Podcast="podcast" />
			</ItemTemplate>
		</Carousel>
	</div>
	<!--New-->
	<div class="d-flex flex-column gap-2">
		<div class="podcastsHeader">
			<span class="header-3">@Resource.NewPodcasts</span>
			<div class="podcastsNavigation">
				<button class="p-1 bg-0 rounded-circle carouselButton"
						id="newLeftButton">
					<img src="Home/ArrowLeft.svg" />
				</button>
				<button class="p-1 bg-0 rounded-circle carouselButton"
						id="newRightButton">
					<img src="Home/ArrowRight.svg" />
				</button>
			</div>
		</div>
		<Carousel Class="podcastsContainer"
				  Items="NewPodcasts"
				  LeftButtonId="newLeftButton"
				  RightButtonId="newRightButton"
				  Context="podcast">
			<ItemTemplate>
				<PodcastView Podcast="podcast" />
			</ItemTemplate>
		</Carousel>
	</div>
	<!--Categories-->
	<div class="d-flex flex-column gap-2">
		<span class="header-3">@Resource.ExploreByCategory</span>
		<div class="categoryLayout">
			@foreach(var category in Categories)
			{
				<a href="@category.Uri" class="bg-1 hoverable rounded-2 categoryButton">
					<img src="@category.ImageSource" class="buttonImg" />
					<span>@category.LocalizedName</span>
				</a>
			}
		</div>
	</div>
</div>
