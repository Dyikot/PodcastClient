@page "/library"
@attribute [Authorize]
@inject PodcastRssFetcher PodcastRssFetcher
@inject UserContext UserContext
@inject PodcastsService PodcastsService
@inject DialogService Dialog
@inject ILogger<Library> Logger
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory

<PageTitle>@Resource.Library</PageTitle>

<div class="m-3 d-flex flex-column gap-2">
	<button class="defaultButton bg-1 hoverable rounded-2 align-self-start"
			@onclick="OpenRssDialog">
		<img src="Library/Add.svg" class="buttonImg" />
		<span>@Resource.Subscribe</span>
	</button>
	<dialog id="rssDialog" class="bg-1 rounded-2 border-main">
		<EditForm method="dialog" class="dialogLayout fg-main"
				  EditContext="_editContext"
				  OnValidSubmit="OnRssFeedSubmit">
			<DataAnnotationsValidator />
			<div class="d-flex flex-column gap-2">
				<div class="fontSize-1">@Resource.EnterRss</div>
				<InputText @bind-Value="RssFeed.Url"
						   placeholder="https://rss-feed.com"
						   class="form-control"/>
				<ValidationMessage For="() => RssFeed.Url" />
			</div>
			<div class="d-flex gap-1 justify-content-end">
				<button class="defaultButton bg-2 hoverable rounded-2" type="button"
						@onclick="CloseRssDialog">
					@Resource.Cancel
				</button>
				<button class="defaultButton bg-2 hoverable rounded-2" type="submit">
					@Resource.Submit
				</button>
			</div>
		</EditForm>
	</dialog>
	<!--Podcasts-->
	<div class="d-flex flex-wrap justify-content-start my-2 gap-2">
		@foreach (var podcast in Podcasts)
		{
			<PodcastView Podcast="podcast" />
		}
		@if(IsAddingPodcast)
		{
			<LoadingPodcastView />
		}
	</div>
</div>


