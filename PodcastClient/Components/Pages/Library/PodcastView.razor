@using PodcastClient.Data
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject UserContext UserContext

<a class="layout fg-main bg-1 hoverable rounded-2" href="@Href" role="button">
	<div class="content">
		<!--New articles view-->
		@if (NewEpisodes > 0)
		{
			<div class="newEpisodesLayout rounded-circle">
				@int.Min(NewEpisodes, 99)
			</div>
		}
		<!--Icon-->
		<img src="@Podcast.IconSource" class="contentLogo rounded-2 mb-1" />
		<!--Title and author-->
		<div class="fontSize-1 text-truncate">@Podcast.Title</div>
		<div class="fontSize-r1 fg-main-3 overflowOn2">@Podcast.Author</div>
	</div>
</a>