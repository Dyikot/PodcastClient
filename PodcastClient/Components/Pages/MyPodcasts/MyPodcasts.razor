@page "/"
@inject PodcastRssFetcher PodcastRssFetcher
@inject UserContext UserContext
@inject PodcastsService PodcastsService
@inject NavigationManager Navigator
@inject ILogger<MyPodcasts> Logger
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory

<PageTitle>@Resource.MyPodcasts</PageTitle>

<div class="m-3 d-flex flex-column gap-2">
	<div class="d-flex align-items-center gap-2" style="height: 50px;">
	<!--Subscribe expander-->
	<Expander HeaderClass="btn bg-1 hoverable canBeActive rounded-2 d-flex align-items-center gap-1"
			  ContentClass="bg-1 rounded-2 p-2 top-50 translate-middle-y d-flex justify-content-around align-items-center gap-2"
			  DropDownPosition="DropDownPosition.Right">
		<HeaderTemplate>
			<img src="MyPodcasts/Add.svg" width="24" height="24" />
			<span>@Resource.Subscribe</span>
		</HeaderTemplate>
		<ContentTemplate>
			<img src="MyPodcasts/RssFeed.svg" />
			<InputText @bind-Value="RssFeed"
					   placeholder="https://rss-feed.com"
					   class="fg-main bg-0 border border-0"
					   style="outline: none" />
			<button class="btn bg-2 hoverable canBeActive rounded-2"
					@onclick="OnSubmitButtonClick">
				@Resource.Submit
			</button>
		</ContentTemplate>
	</Expander>
	</div>
	<!--Podcasts-->
	<div class="d-flex flex-wrap justify-content-start my-2 gap-2">
		@foreach (var podcast in Podcasts)
		{
			<PodcastView Podcast="podcast" Click="OnPodcastClick" />
		}
	</div>
</div>


