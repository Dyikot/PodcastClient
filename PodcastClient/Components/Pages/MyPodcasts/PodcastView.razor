<style>
	#title {
		flex-basis: 24%;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		text-overflow: ellipsis;
		margin: 0px;
	}

	#author {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	#new-episodes {
		position: absolute;
		background-color: orange;
		border-radius: 50px;
		width: 24px;
		height: 24px;
		bottom: 200px;
		left: 115px;
		color: black;
		cursor: default;
		text-align: center;
		font-size: 0.95rem;
	}
</style>

<button class="bg-1 hoverable canBeActive d-flex justify-content-center align-items-center"
		style="width: 200px; height: 240px;"
		@onclick="OnClick">
	<div class="position-relative d-flex flex-column"
		 style="width: 130px; height: 90%;">
		@if (NewEpisodes.Count > 0)
		{
			<span id="new-episodes">@int.Min(NewEpisodes.Count, 99)</span>
		}
		<img src="@Podcast.IconUrl" 
			 class="rounded-2 mb-1"
			 style="height: 130px"
			 @onclick="OnClick" />
		<h5 id="title">@Podcast.Title</h5>
		<span id="author" class="text-grey">@Podcast.Author</span>
	</div>
</button>