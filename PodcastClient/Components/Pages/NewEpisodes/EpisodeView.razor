@inject IStringLocalizer<Resource> Localizer
@inject UserContext UserContext

<NavLink class="btn bg-1 hoverable d-flex align-items-center gap-3 px-3" 
		 style="height: 90px"
		 href="@Href" role="button">
	<!--Icon-->
	<img src="@Episode.IconSource" class="rounded-2" width="64" height="64" />
	<!--Titles-->
	<div class="d-flex flex-column align-items-start gap-2"
		 style="max-width: 65%;">
		<div class="fontSize-1 text-truncate mw-100 fw-bold">@Episode.Title</div>
		<div class="">@PodcastTitle</div>
	</div>
	<!--Duration and date-->
	<div class="d-flex flex-column gap-2 align-items-end flex-grow-1">
		<span>@Episode.Duration.ToLocalizedString(Localizer)</span>
		<span class="text-end">@Episode.ReleaseDate.ToLocalizedString(Localizer)</span>
	</div>
</NavLink>