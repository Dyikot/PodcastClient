@inject IStringLocalizer<Resource> Localizer

<a class="layout bg-1 hoverable rounded-2" href="@Href" role="button">
	<!--Icon-->
	<img src="@Episode.IconSource" class="rounded-start-2 icon" />
	<!--Description-->
	<div class="description">
		<div class="">@Episode.ReleaseDate.ToLocalizedString(Localizer)</div>
		<div class="fontSize-1 text-truncate fw-semibold">@Episode.Title</div>
		<div class="fg-main-2">@PodcastTitle</div>
	</div>
	<!--Duration-->
	<div>@Episode.Duration.ToLocalizedString(Localizer)</div>
</a>