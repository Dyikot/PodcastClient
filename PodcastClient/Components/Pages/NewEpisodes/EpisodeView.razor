@inject IStringLocalizer<Resource> Localizer

<a class="layout bg-1 hoverable rounded-2" href="@Href" role="button">
	<!--Icon-->
	<img src="@Episode.IconSource" class="rounded-start-2" height="80" />
	<!--Description-->
	<div class="description">
		<span class="fontSize-r-1">@Episode.ReleaseDate.ToLocalizedString(Localizer)</span>
		<span class="fontSize-1 text-truncate fw-semibold">@Episode.Title</span>
		<span>@PodcastTitle</span>
	</div>
	<!--Duration-->
	<span>@Episode.Duration.ToLocalizedString(Localizer)</span>
</a>