@page "/new-episodes"
@attribute [Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject UserContext UserContext

<PageTitle>@Resource.NewEpisodes</PageTitle>

<div class="my-3 mx-4 d-flex flex-column align-items-stretch" 
	 style="gap: 0.75rem">
	@foreach (var episodeViewModel in Episodes)
	{
		<EpisodeView DataContext="episodeViewModel" />
	}
</div>