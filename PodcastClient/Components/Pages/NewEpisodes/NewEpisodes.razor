@page "/new-episodes"
@attribute [Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject UserContext UserContext

<PageTitle>@Resource.NewEpisodes</PageTitle>

<div class="my-4 mx-4">
	@if(Episodes.Count > 0)
	{
		<div class="d-flex flex-column align-items-stretch"
			 style="gap: 0.75rem">
			@foreach (var episodeViewModel in Episodes.Skip((Page - 1) * ItemsPerPage).Take(ItemsPerPage))
			{
				<EpisodeView DataContext="episodeViewModel" />
			}
		</div>
		<PageNavigationControl Class="mt-4" 
							   Page="@Page" 
							   PageAmount="@PageAmount" 
							   ButtonsAmount="5" />
	}
	else
	{
		<div class="d-flex align-items-center justify-content-center">
			<span class="fontSize-4">@Resource.NoNewEpisodes</span>
		</div>
	}
</div>