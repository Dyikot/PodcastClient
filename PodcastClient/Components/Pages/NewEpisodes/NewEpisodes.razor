@page "/new-episodes"
@rendermode InteractiveServer
@inject IStringLocalizer<Resources.Resource> Localizer
@inject PodcastCollection PodcastCollection

<PageTitle>@Localizer["NewEpisodes"]</PageTitle>

<main>
	<div id="new-episodes-list">
		@foreach(var episode in Episodes)
		{
			<EpisodeBlock Episode="episode" />
		}
	</div>
</main>