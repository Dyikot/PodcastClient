@page "/now-playing"
@inject IStringLocalizer<Resources.Resource> Localizer
@inject PodcastCollection PodcastCollection
@inject MediaService MediaService

<PageTitle>@(Episode?.Title ?? Resource.NoPlayingPodcast)</PageTitle>

<div class="h-100 d-flex flex-column align-items-center gap-2">
	@if(Episode == null)
	{
		<h2 class="m-2 align-self-start">
			@Resource.NoPlayingPodcast
		</h2>
	}
	else
	{
		<div class="d-flex gap-3 mt-4 w-75">
			<img src="@Episode.IconUri" class="rounded-2" width="150" height="150" />
			<div class="d-flex flex-column align-items-start gap-1">
				<h5>@Episode.Title</h5>
				<span>@Episode.Podcast!.Title</span>
				<div class="d-flex align-items-stretch gap-2" style="height: 25px">
					<div class="d-flex align-items-md-center gap-1">
						<img src="NowPlaying/Calendar.svg" class="h-100" />
						<span>@Episode.ReleaseDate.ToLocalizedString(Localizer)</span>
					</div>
					<div class="d-flex align-items-center gap-1">
						<img src="NowPlaying/Time.svg" class="h-100" />
						<span>@Episode.Duration.ToString("hh':'mm':'ss")</span>
					</div>
				</div>
				<a class="bg-0 hoverable canBeActive rounded-2 mt-auto p-1" 
				   title="@Resource.Source"
				   href="@Episode.Link" 
				   target="_blank">
					<img src="NowPlaying/Link.svg" />
				</a>
			</div>
		</div>
		<div class="w-75 order-2">
			@Episode.Description
		</div>
		switch (Episode.Type)
		{
			case Models.EpisodeType.Audio:
				<AudioPlayer Source="@Episode.ContentUri"
							 Duration="@Episode.Duration"
							 @bind-CurrentTime="Episode.Played"
							 @bind-Volume="MediaService.AudioVolume"
							 @bind-PlaySpeed="MediaService.AudioPlaySpeed"
							 OnPlay="@OnPlay"
							 OnPlayed="@OnPlayed" />
				break;
			case Models.EpisodeType.Video:
				<div class="d-flex w-75 order-1 mb-4">
					<VideoPlayer Source="@Episode.ContentUri"
								 Duration="@Episode.Duration"
								 @bind-CurrentTime="Episode.Played"
								 @bind-Volume="MediaService.VideoVolume"
								 @bind-PlaySpeed="MediaService.VideoPlaySpeed"
								 OnPlay="@OnPlay"
								 OnPlayed="@OnPlayed" />
				</div>
				break;
		}
	}
</div>
