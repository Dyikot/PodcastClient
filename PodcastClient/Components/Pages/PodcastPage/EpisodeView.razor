@inject IStringLocalizer<Resource> Localizer

<div class="layout bg-1 hoverable">
	<!--Date, mark and additional features-->
	<div class="d-flex gap-2" style="height: 25px">
		<div>@Episode.ReleaseDate.ToLocalizedString(Localizer)</div>
		@if(HasPlayed)
		{
			<span class="text-success">@Resource.Played</span>
		}
		<Expander Class="ms-auto"
				  HeaderClass="bg-transparent rounded-2"
				  ContentClass="border-main text-nowrap expanderPosition py-2 bg-1 rounded-2 d-flex flex-column"
				  DropDownPosition="DropDownPosition.Top"
				  @ref="_expander">
			<HeaderTemplate>
				<img src="Podcast/MoreHorizontal.svg" class="ms-auto buttonImg" />
			</HeaderTemplate>
			<ContentTemplate>
				<button class="btn border-0 p-1 bg-1 hoverable  @Disabled" 
						@onclick="OnMarkPlayedClick">
					@if(HasPlayed)
					{
						@Resource.MarkAsUnplayed
					}
					else
					{
						@Resource.MarkAsPlayed
					}
				</button>
			</ContentTemplate>
		</Expander>
	</div>
	<!--Desription-->
	<a class="linkLayout" href="@Href" role="button">
		<!--Title and description-->
		<div class="mw-100 fw-bold fontSize-1 m-0 text-start text-truncate">
			@Episode.Title
		</div>
		<div class="fg-main-2 overflowOn2 text-start no-link-text no-header-text">
			@Description
		</div>
		<!--Durtion-->
		<div class="mt-1">@Episode.Duration.ToLocalizedString(Localizer)</div>
	</a>
</div>
