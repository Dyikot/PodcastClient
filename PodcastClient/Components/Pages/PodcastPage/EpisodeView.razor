@inject IStringLocalizer<Resource> Localizer
@inject NavigationManager Navigator
@inject PodcastCollection PodcastCollection

<button class="bg-1 hoverable canBeActive rounded-3 d-flex p-3"
		style="height: 140px">
	<!--Main block-->
	<div class="d-flex flex-column align-items-start gap-1"
		 style="width: 85%"
		 @onclick="OnClick">
		<!--Date and episodes number-->
		<div class="d-flex gap-1">
			<span>@Episode.ReleaseDate.ToLocalizedString(Localizer)</span>
			<span>•</span>
			<span>@($"{Localizer["Episode"]}: {Episode.Number}")</span>
		</div>
		<!--Title and description-->
		<div class="fw-bold mw-100 m-0 text-start">@Episode.Title</div>
		<div class="overflowOn2 text-start mw-100 no-link-text no-header-text">
			@Episode.Description
		</div>
	</div>
	<!--Side block-->
	<div class="flex-grow-1 ms-2 d-flex justify-content-around align-items-center">
		<ToggleButton Class="bg-transparent p-0"
					  CheckedClass="bg-transparent p-0"
					  IsChecked="@HasPlayed">
			<ContentTemplate>
				<img src="PodcastPage/Check.svg" width="40" height="40" />
			</ContentTemplate>
			<CheckedContentTemplate>
				<img src="PodcastPage/CheckFill.svg" width="40" height="40" />
			</CheckedContentTemplate>
		</ToggleButton>
		@* @switch(Episode.Status)
		{
			case Models.EpisodeStatus.Played:
				<img @onclick="OnFinishedMarkClick" src="PodcastPage/CheckFill.svg" 
					 width="40" height="40" />
				break;
			default:
				<img @onclick="OnNotStartedMarkClick" src="PodcastPage/Check.svg"
					 width="40" height="40" />
				break;
		} *@
		<span>@Episode.Duration.ToString("hh':'mm':'ss")</span>
	</div>
</button>
