@page "/my_podcasts/{name}"
@rendermode InteractiveServer
@inject PodcastCollection PodcastCollection
@inject NavigationManager Navigator
@inject IStringLocalizer<Resources.Resource> Localizer

<PageTitle>@(Podcast?.Name ?? Localizer["Error"])</PageTitle>

<main>
	@if(Podcast == null)
	{
		<h1>@Localizer["PodcastNull"]</h1>
	}
	else
	{
		<style>
			.about-body-description-text a:link {
				color: inherit;
				text-decoration: none;
				pointer-events: none;
			}

			.about-body-description-text :is(h1, h2, h3, h4, h5, h6) {
				font-size: 1rem;
			}
		</style>
		<div id="about-layout" class="panel">
			<div id="about">
				<img src="@Podcast.IconUrl" alt="Could not find the image" />
				<div id="about-content">
					<h4 id="about-content-name">@Podcast.Name</h4>
					<div id="about-content-owner">
						<span>@Podcast.Author</span>
						<span>•</span>
						<span>@($"{Localizer["Episodes"]}: {Podcast.Episodes.Count}")</span>
					</div>
					<div id="about-content-description">@Podcast.Description</div>
					<div id="about-content-buttons">
						<button class="panel-item" @onclick="OnUnsubscribeButtonClick">
							@Localizer["Unsubscribe"]
						</button>
					</div>
				</div>
			</div>
		</div>
		<div id="episodes">
			<div id="episodes-buttons">
				<div>
					<select @bind="SortOrder">
						<option value="@SortOrder.Latest">@Localizer["Latest"]</option>
						<option value="@SortOrder.Oldest">@Localizer["Oldest"]</option>
					</select>
					<SwitchButton NormalClass="item"
								  ActiveClass="panel-item-active"
								  @bind-IsActive="@IsInProgressButtonActive"
								  OnActivated="OnInProgressButtonClick">
						@Localizer["InProgress"]
					</SwitchButton>
					<SwitchButton NormalClass="item"
								  ActiveClass="panel-item-active"
								  @bind-IsActive="@IsFinishedButtonActive"
								  OnActivated="OnFinishedButtonClick">
						@Localizer["Played"]
					</SwitchButton>
					<SwitchButton NormalClass="item"
								  ActiveClass="panel-item-active"
								  @bind-IsActive="@IsNotStartedButtonActive"
								  OnActivated="OnNotStartedButtonClick">
						@Localizer["Unplayed"]
					</SwitchButton>		
				</div>
				<div>
					<button class="item" @onclick="OnMarkAllItemsButtonClick">
						@Localizer["MarkPlayedAll"]
					</button>
					<button class="item" @onclick="OnUnmarkAllItemsButtonClick">
						@Localizer["UnMarkPlayedAll"]
					</button>
				</div>
			</div>
			<div id="episodes-list">
				@if(SortOrder == SortOrder.Latest)
				{
					@foreach (var episode in Episodes)
					{
						<EpisodeView Episode="episode" />
					}				
				}
				else
				{
					@for (int i = Episodes.Count - 1; i >= 0; i--)
					{
						<EpisodeView Episode="Episodes[i]" />
					}
				}
			</div>
		</div>
	}
</main>