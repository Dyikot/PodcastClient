@page "/podcast/{podcastId:int}"
@inject UserContext UserContext
@inject PodcastsService PodcastsService
@inject IStringLocalizer<Resource> Localizer
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory

<PageTitle>@(Podcast?.Title ?? Resource.Error)</PageTitle>

<style>
	.no-link-text a:link {
		color: inherit;
		text-decoration: none;
		pointer-events: none;
	}

	.no-header-text :is(h1, h2, h3, h4, h5, h6) {
		font-size: 1rem;
	}
</style>

<div class="d-flex flex-column">
	@if(Podcast == null)
	{
		<h1>@Resource.PodcastNotFound</h1>
	}
	else
	{	
		<!--Header-->
		<div class="headerBgLayout">
			<div class="mainLayout headerLayout">
				<!--Icon-->
				<img src="@Podcast.IconSource" class="icon rounded-2"  />
				<!--About-->
				<div class="d-flex align-items-start flex-column">
					<div class="fontSize-3 fw-semibold">@Podcast.Title</div>
					<div>@Podcast.Author</div>
					<div>@($"{Resource.Episodes}: {Podcast.Episodes.Count}")</div>
					<div class="mt-2 mb-4">@Description</div>
					<AuthorizeView>
						<Authorized>
							<ToggleButton Class="mt-auto defaultButton bg-2 hoverable rounded-2"
										  CheckedClass="mt-auto defaultButton bg-2 hoverable rounded-2"
										  IsChecked="UserHasSubscription"
										  IsEnabled="UserContext.IsAuthenticated"
										  OnClick="OnSubscribeButtonClick">
								<ContentTemplate>@Resource.Subscribe</ContentTemplate>
								<CheckedContentTemplate>@Resource.Unsubscribe</CheckedContentTemplate>
							</ToggleButton>
						</Authorized>
						<NotAuthorized>
							<a href="signin" class="mt-auto linkButton bg-2 hoverable rounded-2">
								@Resource.Subscribe
							</a>
						</NotAuthorized>
					</AuthorizeView>
				</div>
			</div>
		</div>
		<!--Main-->
		<div class="mainLayout p-3 m-auto d-flex flex-column gap-3">
			<!--Sort and filter buttons-->
			<div class="buttonsLayout">
				<ComboBox Items="SortOrderOptions"
						  @bind-SelectedItem="SortOrder"
						  ButtonClass="defaultButton bg-1 rounded-2"
						  Context="context">
					<ItemTemplate>
						@Localizer[context.ToString()]
					</ItemTemplate>
				</ComboBox>
				@if(UserHasSubscription)
				{
					<div class="d-flex gap-2">
						<ToggleButton Class="defaultButton bg-1 hoverable rounded-2"
									  CheckedClass="defaultButton bg-2 hoverable rounded-2"
									  IsChecked="IsInProgressFilter"
									  OnClick="OnInProgressButtonClick">
							<ContentTemplate>@Resource.InProgress</ContentTemplate>
							<CheckedContentTemplate>@Resource.InProgress</CheckedContentTemplate>
						</ToggleButton>
						<ToggleButton Class="defaultButton bg-1 hoverable rounded-2"
									  CheckedClass="defaultButton bg-2 hoverable rounded-2"
									  IsChecked="IsPlayedFilter"
									  OnClick="OnPlayedButtonClick">
							<ContentTemplate>@Resource.Played</ContentTemplate>
							<CheckedContentTemplate>@Resource.Played</CheckedContentTemplate>
						</ToggleButton>
						<ToggleButton Class="defaultButton bg-1 hoverable  rounded-2"
									  CheckedClass="defaultButton bg-2 hoverable  rounded-2"
									  IsChecked="IsUnplayedFilter"
									  OnClick="OnUnplayedButtonClick">
							<ContentTemplate>@Resource.Unplayed</ContentTemplate>
							<CheckedContentTemplate>@Resource.Unplayed</CheckedContentTemplate>
						</ToggleButton>
					</div>
				}
			</div>
			<!--Podcasts-->
			<div class="d-flex flex-column gap-3 mb-3">
				@if (UserHasSubscription)
				{
					@foreach (var userEpisode in UserEpisodes!.Skip((Page - 1) * ItemsPerPage).Take(ItemsPerPage))
					{
						<EpisodeView Episode="userEpisode.Episode"
									 UserEpisode="userEpisode"
									 OnStatusChanged="OnEpisodeStatusChanged" />
					}
				}
				else
				{
					@foreach (var episode in Episodes!.Skip((Page - 1) * ItemsPerPage).Take(ItemsPerPage))
					{
						<EpisodeView Episode="episode" />
					}
				}
			</div>
			<PageNavigationControl Page="@Page" PageAmount="@PageAmount" ButtonsAmount="5" />
		</div>
	}
</div>