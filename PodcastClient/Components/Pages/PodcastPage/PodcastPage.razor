@page "/my_podcasts/{name}"
@inject PodcastCollection PodcastCollection
@inject NavigationManager Navigator

<PageTitle>@(Podcast?.Title ?? Resource.Error)</PageTitle>

<style>
	.no-link-text a:link {
		color: inherit;
		text-decoration: none;
		pointer-events: none;
	}

	.no-header-text :is(h1, h2, h3, h4, h5, h6) { font-size: 1rem; }
</style>

<div>
	@if(Podcast == null)
	{
		<h1>@Resource.PodcastNull</h1>
	}
	else
	{	
		<div class="bg-1 d-flex justify-content-center align-items-center mb-3"
			 style="height: 300px">
			<!--Header-->
			<div class="d-flex gap-3" style="width: 75%; height: 80%">
				<img src="@Podcast.IconUrl" class="rounded-2" width="150" height="150"  />
				<div class="h-100 d-flex flex-column align-items-stretch gap-1">
					<h4 class="m-0">@Podcast.Title</h4>
					<div class="d-flex gap-2">
						<span>@Podcast.Author</span>
						<span>•</span>
						<span>@($"{Resource.Episodes}: {Podcast.Episodes.Count}")</span>
					</div>
					<div class="h-100 overflowOn5">@Podcast.Description</div>
					<div class="d-flex align-items-end gap-2">
						<button class="btn bg-2 hoverable canBeActive rounded-2" 
								@onclick="OnUnsubscribeButtonClick">
							@Resource.Unsubscribe
						</button>
					</div>
				</div>
			</div>
		</div>
		<!--Main-->
		<div class="d-flex flex-column gap-4 w-75 m-auto">
			<!--Sort and filter buttons-->
			<div class="d-inline-flex gap-2">
				<select class="fg-main bg-1 p-1 rounded-2" @bind="SortOrder">
					<option value="@SortOrder.Latest">@Resource.Latest</option>
					<option value="@SortOrder.Oldest">@Resource.Oldest</option>
				</select>
				<ToggleButton Class="btn bg-1 hoverable canBeActive rounded-2"
							  CheckedClass="btn bg-2 hoverable canBeActive rounded-2"
							  IsChecked="@IsInProgressButtonActive"
							  OnClick="OnInProgressButtonClick">
					<ContentTemplate>@Resource.InProgress</ContentTemplate>
					<CheckedContentTemplate>@Resource.InProgress</CheckedContentTemplate>
				</ToggleButton>
				<ToggleButton Class="btn bg-1 hoverable canBeActive rounded-2"
							  CheckedClass="btn bg-2 hoverable canBeActive rounded-2"
							  IsChecked="@HasPlayedButtonActive"
							  OnClick="OnPlayedButtonClick">
					<ContentTemplate>@Resource.Played</ContentTemplate>
					<CheckedContentTemplate>@Resource.Played</CheckedContentTemplate>
				</ToggleButton>
				<ToggleButton Class="btn bg-1 hoverable canBeActive rounded-2"
							  CheckedClass="btn bg-2 hoverable canBeActive rounded-2"
							  IsChecked="@HasUnplayedButtonActive"
							  OnClick="OnUnplayedButtonClick">
					<ContentTemplate>@Resource.Unplayed</ContentTemplate>
					<CheckedContentTemplate>@Resource.Unplayed</CheckedContentTemplate>
				</ToggleButton>
			</div>
			<!--Podcasts-->
			<div class="d-flex flex-column gap-3 mb-3">
				@if(SortOrder == SortOrder.Latest)
				{
					@foreach (var episode in Episodes)
					{
						<EpisodeView Episode="episode" />
					}				
				}
				else
				{
					@for (int i = Episodes.Count - 1; i >= 0; i--)
					{
						<EpisodeView Episode="Episodes[i]" />
					}
				}
			</div>
		</div>
	}
</div>