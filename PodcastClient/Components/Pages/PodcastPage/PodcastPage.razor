@page "/podcast/{podcastId:int}"
@inject NavigationManager Navigator
@inject UserContext UserContext
@inject PodcastsService PodcastsService
@inject IStringLocalizer<Resource> Localizer
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory

<PageTitle>@(Podcast?.Title ?? Resource.Error)</PageTitle>

<style>
	.no-link-text a:link {
		color: inherit;
		text-decoration: none;
		pointer-events: none;
	}

	.no-header-text :is(h1, h2, h3, h4, h5, h6) { font-size: 1rem; }
</style>

<div>
	@if(Podcast == null)
	{
		<h1>@Resource.PodcastNotFound</h1>
	}
	else
	{	
		<div class="bg-1 d-flex justify-content-center align-items-center mb-3"
			 style="height: 300px">
			<!--Header-->
			<div class="d-flex gap-3" style="width: 75%; height: 80%">
				<img src="@Podcast.IconSource" class="rounded-2" width="150" height="150"  />
				<div class="h-100 d-flex flex-column align-items-stretch gap-1">
					<h4 class="m-0">@Podcast.Title</h4>
					<div class="d-flex gap-2">
						<span>@Podcast.Author</span>
						<span>•</span>
						<span>@($"{Resource.Episodes}: {Podcast.Episodes.Count}")</span>
					</div>
					<div class="h-100 overflowOn5">@Description</div>
					<div class="d-flex align-items-end gap-2">
						<ToggleButton Class="btn bg-2 hoverable canBeActive rounded-2"
									  CheckedClass="btn bg-2 hoverable canBeActive rounded-2"
									  IsChecked="UserHasSubscription"
									  OnClick="OnSubscribeButtonClick">
							<ContentTemplate>@Resource.Subscribe</ContentTemplate>
							<CheckedContentTemplate>@Resource.Unsubscribe</CheckedContentTemplate>
						</ToggleButton>
					</div>
				</div>
			</div>
		</div>
		<!--Main-->
		<div class="d-flex flex-column gap-4 mainLayout m-auto">
			<!--Sort and filter buttons-->
			<div class="d-flex gap-2">
				<ComboBox TItem="PodcastClient.Data.SortOrder"
						  Items="SortOrderOptions"
						  @bind-SelectedItem="SortOrder"
						  ButtonClass="p-2"
						  Context="context">
					<ItemTemplate>
						@Localizer[context.ToString()]
					</ItemTemplate>
				</ComboBox>
				@if(UserHasSubscription)
				{
					<ToggleButton Class="btn bg-1 hoverable canBeActive rounded-2"
								  CheckedClass="btn bg-2 hoverable canBeActive rounded-2"
								  IsChecked="IsInProgressFilter"
								  OnClick="OnInProgressButtonClick">
						<ContentTemplate>@Resource.InProgress</ContentTemplate>
						<CheckedContentTemplate>@Resource.InProgress</CheckedContentTemplate>
					</ToggleButton>
					<ToggleButton Class="btn bg-1 hoverable canBeActive rounded-2"
								  CheckedClass="btn bg-2 hoverable canBeActive rounded-2"
								  IsChecked="IsPlayedFilter"
								  OnClick="OnPlayedButtonClick">
						<ContentTemplate>@Resource.Played</ContentTemplate>
						<CheckedContentTemplate>@Resource.Played</CheckedContentTemplate>
					</ToggleButton>
					<ToggleButton Class="btn bg-1 hoverable canBeActive rounded-2"
								  CheckedClass="btn bg-2 hoverable canBeActive rounded-2"
								  IsChecked="IsUnplayedFilter"
								  OnClick="OnUnplayedButtonClick">
						<ContentTemplate>@Resource.Unplayed</ContentTemplate>
						<CheckedContentTemplate>@Resource.Unplayed</CheckedContentTemplate>
					</ToggleButton>					
				}
			</div>
			<!--Podcasts-->
			<div class="d-flex flex-column gap-3 mb-3">
				@if (UserHasSubscription)
				{
					@foreach (var episode in UserEpisodes!)
					{
						<UserEpisodeView UserEpisode="episode" 
										 StatusChanged="OnEpisodeStatusChanged" />
					}
				}
				else
				{
					@foreach (var episode in Episodes!)
					{
						<EpisodeView Episode="episode" />
					}
				}
			</div>
		</div>
	}
</div>