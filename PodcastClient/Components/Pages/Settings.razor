@page "/settings"
@inject DialogService Dialog
@inject LocalStorage LocalStorage
@inject ThemeService ThemeService
@inject CultureService CultureService
@inject IStringLocalizer<Resource> Localizer

<PageTitle>@Resource.Settings</PageTitle>

<div class="layout mainLayout">
	<!--Appearance-->
	<div class="sectionLayout">
		<span class="header-3">@Resource.Appearance</span>
		<hr />
		<div class="sectionContent">
			<!--Language-->
			<div class="settingLayout">
				<div class="settingTitle">@Resource.Language</div>
				<ComboBox TItem="CultureInfo"
						  Items="LanguageOptions"
						  @bind-SelectedItem="CultureService.Culture"
						  ButtonClass="defaultButton settingComboBox bg-1 rounded-2"
						  Context="culture">
					<ItemTemplate>
						@GetLanguageLabel(culture)
					</ItemTemplate>
				</ComboBox>
			</div>
			<!--Theme-->
			<div class="settingLayout">
				<div class="settingTitle">@Resource.Theme</div>
				<ComboBox TItem="string"
						  Items="ThemeOptions"
						  @bind-SelectedItem="ThemeService.Theme"
						  SelectionChanged="OnThemeChanged"
						  ButtonClass="defaultButton settingComboBox bg-1 rounded-2"
						  Context="theme">
					<ItemTemplate>
						@Localizer[theme]
					</ItemTemplate>
				</ComboBox>
			</div>
		</div>
	</div>
	<AuthorizeView>
		<!--Account-->
		<div class="sectionLayout">
			<span class="header-3">@Resource.Account</span>
			<hr />
			<div class="sectionContent">
				<!--Change password-->
				<div class="settingLayout">
					<button class="defaultButton bg-1 hoverable rounded-2">
						<img src="Settings/KeyVertical.svg" class="buttonImg" />
						<span>@Resource.SettingsChangePassword</span>
					</button>
				</div>
				<dialog id="changePasswordDialog">
					<EditForm method="dialog" class="dialogLayout fg-main"
							  Model="ChangePasswordModel"
							  OnValidSubmit="ChangePasswordAsync">
						<DataAnnotationsValidator />
						
					</EditForm>
				</dialog>
				<!--Delete account-->
				<div class="settingLayout">
					<button class="defaultButton bg-1 hoverable rounded-2">
						<img src="Settings/AccountDelete.svg" class="buttonImg" />
						<span>@Resource.SettingDeleteAccount</span>
					</button>
				</div>
				<dialog id="deleteAccountDialog">

				</dialog>
			</div>
		</div>
	</AuthorizeView>
</div>