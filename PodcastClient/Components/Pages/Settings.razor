@page "/settings"
@inject UserContext User
@inject DialogService Dialog
@inject LocalStorage LocalStorage
@inject ThemeService ThemeService
@inject CultureService CultureService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Resource> Localizer
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory

<PageTitle>@Resource.Settings</PageTitle>

<div class="layout mainLayout">
	<!--Appearance-->
	<div class="sectionLayout">
		<span class="header-3">@Resource.Appearance</span>
		<hr />
		<div class="sectionContent">
			<!--Language-->
			<div class="settingLayout">
				<div class="settingTitle">@Resource.Language</div>
				<ComboBox TItem="CultureInfo"
						  Items="LanguageOptions"
						  @bind-SelectedItem="CultureService.Culture"
						  ButtonClass="defaultButton settingComboBox bg-1 rounded-2"
						  Context="culture">
					<ItemTemplate>
						@GetLanguageLabel(culture)
					</ItemTemplate>
				</ComboBox>
			</div>
			<!--Theme-->
			<div class="settingLayout">
				<div class="settingTitle">@Resource.Theme</div>
				<ComboBox TItem="string"
						  Items="ThemeOptions"
						  @bind-SelectedItem="ThemeService.Theme"
						  SelectionChanged="OnThemeChanged"
						  ButtonClass="defaultButton settingComboBox bg-1 rounded-2"
						  Context="theme">
					<ItemTemplate>
						@Localizer[theme]
					</ItemTemplate>
				</ComboBox>
			</div>
		</div>
	</div>
	<AuthorizeView Context="user">
		<!--Account-->
		<div class="sectionLayout">
			<span class="header-3">@Resource.Account</span>
			<hr />
			<div class="sectionContent">
				<!--Change password-->
				<div class="settingLayout gap-2">
					<button class="defaultButton bg-1 hoverable rounded-2"
							@onclick="OpenChangePasswordDialog">
						<img src="Settings/KeyVertical.svg" class="buttonImg" />
						<span>@Resource.SettingsChangePassword</span>
					</button>
					@if (_passwordChanged)
					{
						<div class="text-success">@Resource.PasswordChanged</div>
					}
				</div>
				<!--Change password dialog-->
				<dialog id="changePasswordDialog" class="fg-main bg-0 border-main rounded-2">
					<EditForm method="dialog" class="dialogLayout"
							  Model="ChangePasswordModel"
							  OnValidSubmit="ChangePasswordAsync">
						<DataAnnotationsValidator />
						<div class="header-4 m-auto">@Resource.PasswordChange</div>
						<!--Current password-->
						<div>
							<div class="form-label">@Resource.CurrentPassword</div>
							<InputText class="form-control" type="password"
									   @bind-Value="ChangePasswordModel.CurrentPassword" />
							<ValidationMessage For="() => ChangePasswordModel.CurrentPassword" />
						</div>
						<!--New password-->
						<div>
							<div class="form-label">@Resource.NewPassword</div>
							<InputText class="form-control" type="password"
									   @bind-Value="ChangePasswordModel.Password" />
							<ValidationMessage For="() => ChangePasswordModel.Password" />
						</div>
						<!--Confirm password-->
						<div>
							<div class="form-label">@Resource.ConfirmPassword</div>
							<InputText class="form-control" type="password"
									   @bind-Value="ChangePasswordModel.ConfirmPassword" />
							<ValidationMessage For="() => ChangePasswordModel.ConfirmPassword" />
						</div>
						@if (_errorMessage != null)
						{
							<div class="validation-message">@_errorMessage</div>
						}
						<!--Cancel/Submit buttons-->
						<div class="d-flex gap-1 justify-content-end">
							<button class="defaultButton bg-1 hoverable rounded-2" type="button"
									@onclick="CloseChangePasswordDialog">
								@Resource.Cancel
							</button>
							<button class="defaultButton bg-1 hoverable rounded-2" type="submit">
								@Resource.Submit
							</button>
						</div>
					</EditForm>
				</dialog>
				<!--Delete account-->
				<div class="settingLayout">
					<button class="defaultButton bg-1 hoverable rounded-2"
							@onclick="OpenConfirmDeleteDialog">
						<img src="Settings/AccountDelete.svg" class="buttonImg" />
						<span>@Resource.SettingDeleteAccount</span>
					</button>
				</div>
				<dialog id="confirmDeleteDialog" class="bg-0 border-main rounded-2 fg-main">
					<div class="dialogLayout">
						<div class="d-flex gap-3 align-items-center">
							<img src="Settings/Warning.svg" style="width: 2.5rem; height: 2.5rem" />
							<div class="flex-fill">@Resource.DeleteAccountWarning</div>
						</div>
						<div class="dialogButtonLayout">
							<button class="btn btn-primary" @onclick="CloseConfirmDeleteDialog">
								@Resource.Cancel
							</button>
							<button class="btn btn-danger" @onclick="DeleteAccount">
								@Resource.Confirm
							</button>
						</div>
					</div>
				</dialog>
			</div>
		</div>
	</AuthorizeView>
</div>