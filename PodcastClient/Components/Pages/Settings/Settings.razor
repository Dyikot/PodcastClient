@page "/settings"
@inject NavigationManager Navigator
@inject ThemeService ThemeService

<PageTitle>@Resource.Settings</PageTitle>

<style>
	.settings-option {
		width: 220px;
	}

	.settings-option-title {
		width: 100px;
	}
</style>

<div class="d-flex flex-column gap-3 m-3">
	<div class="d-flex settings-option">
		<div class="settings-option-title">@Resource.Language</div>
		<select class="fg-main bg-1 rounded p-1 flex-grow-1" @bind="Culture">
			<option value="en-US">English</option>
			<option value="ru-RU">Русский</option>
		</select>
	</div>
	<div class="d-flex settings-option">
		<div class="settings-option-title">@Resource.Theme</div>
		<select class="fg-main bg-1 rounded p-1 flex-grow-1"
				@bind="ThemeService.Active"
				@bind:event="oninput"
				@bind:after="() => Navigator.Refresh()">
			<option value="@ThemeService.Light">@Resource.LightTheme</option>
			<option value="@ThemeService.Dark">@Resource.DarkTheme</option>
		</select>
	</div>
</div>