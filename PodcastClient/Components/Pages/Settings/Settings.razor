@page "/settings"
@inject NavigationManager Navigator
@inject ThemeService ThemeService
@inject IStringLocalizer<Resource> Localizer

<PageTitle>@Resource.Settings</PageTitle>

<div class="d-flex flex-column gap-3 m-3">
	<div class="d-flex">
		<div class="settings-title">@Resource.Language</div>
		<ComboBox TItem="CultureInfo"
				  Items="LanguageOptions"
				  @bind-SelectedItem="Culture"
				  OnItemSelected="(culture) => Navigator.Refresh()"
				  ButtonClass="settings-combobox"
				  Context="context">
			<ItemTemplate>
				@GetLanguageValue(context)
			</ItemTemplate>
		</ComboBox>
	</div>
	<div class="d-flex">
		<div class="settings-title">@Resource.Theme</div>
		<ComboBox TItem="string"
				  Items="ThemeOptions"
				  @bind-SelectedItem="ThemeService.Active"
				  OnItemSelected="(culture) => Navigator.Refresh()"
				  ButtonClass="settings-combobox"
				  Context="context">
			<ItemTemplate>
				@Localizer[context]
			</ItemTemplate>
		</ComboBox>
	</div>
</div>