@page "/settings"
@inject ThemeService ThemeService
@inject CultureService CultureService
@inject LocalStorage LocalStorage
@inject NavigationManager Navigator
@inject IStringLocalizer<Resource> Localizer

<PageTitle>@Resource.Settings</PageTitle>

<div class="d-flex flex-column gap-3 m-3">
	<div class="d-flex align-items-center">
		<div class="settings-title">@Resource.Language</div>
		<ComboBox TItem="CultureInfo"
				  Items="LanguageOptions"
				  @bind-SelectedItem="CultureService.Culture"
				  ButtonClass="settings-combobox"
				  Context="context">
			<ItemTemplate>
				@GetLanguageLabel(context)
			</ItemTemplate>
		</ComboBox>
	</div>
	<div class="d-flex align-items-center">
		<div class="settings-title">@Resource.Theme</div>
		<ComboBox TItem="string"
				  Items="ThemeOptions"
				  @bind-SelectedItem="ThemeService.Theme"
				  SelectionChanged="OnThemeChanged"
				  ButtonClass="settings-combobox"
				  Context="context">
			<ItemTemplate>
				@Localizer[context]
			</ItemTemplate>
		</ComboBox>
	</div>
</div>