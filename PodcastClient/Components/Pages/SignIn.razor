@page "/signin"
@inject NavigationManager NavigationManager
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory

<PageTitle>@Resource.SignIn</PageTitle>

<div class="layout">
	<EditForm class="formLayout bg-1 border-main rounded-2 p-3"
			  Model="User"
			  OnValidSubmit="OnValidSubmit">
		<DataAnnotationsValidator />
		<div class="header-3">@Resource.SignIn</div>
		<!--Username-->
		<div class="w-100">
			<div class="form-label fontSize-1">@Resource.UserName</div>
			<InputText class="form-control" @bind-Value="User.UserName" />
			<ValidationMessage For="@(() => User.UserName)" />
		</div>
		<!--Password-->
		<div class="w-100">
			<div class="form-label fontSize-1">@Resource.Password</div>
			<InputText type="password" class="form-control" @bind-Value="User.Password" />
			<ValidationMessage For="@(() => User.Password)" />
		</div>
		@if(_errorMessage != null)
		{
			<div class="validation-message">@_errorMessage</div>			
		}
		<button class="mt-1 w-100 btn btn-primary" type="submit">
			@Resource.Submit
		</button>
		<p class="mt-1">
			<span>@Resource.NoAccount</span>
			<a href="signup">@Resource.DoSignUp</a>
		</p>
	</EditForm>
</div>
