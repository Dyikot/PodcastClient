@page "/signup"
@inject NavigationManager NavigationManager
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory

<PageTitle>@Resource.SignUp</PageTitle>

<div class="layout">
	<EditForm class="formLayout bg-1 border-main rounded-2 p-3"
			  Model="User"
			  OnValidSubmit="OnValidSubmit">
		<DataAnnotationsValidator />
		<div class="header-3">@Resource.SignUp</div>
		<!--Email-->
		<div class="w-100">
			<div class="form-label fontSize-1">Email</div>
			<InputText class="form-control" @bind-Value="User.Email" />
			<ValidationMessage For="@(() => User.Email)" />
		</div>
		<!--Username-->
		<div class="w-100">
			<div class="form-label fontSize-1">@Resource.UserName</div>
			<InputText class="form-control" @bind-Value="User.UserName" />
			<ValidationMessage For="@(() => User.UserName)" />
		</div>
		<!--Password-->
		<div class="w-100">
			<div class="form-label fontSize-1">@Resource.Password</div>
			<InputText type="password" class="form-control" @bind-Value="User.Password" />
			<ValidationMessage For="@(() => User.Password)" />
		</div>
		<!--Confirm password-->
		<div class="w-100">
			<div class="form-label fontSize-1">@Resource.ConfirmPassword</div>
			<InputText type="password" class="form-control" @bind-Value="User.ConfirmPassword" />
			<ValidationMessage For="@(() => User.ConfirmPassword)" />
		</div>
		@if (_errorMessage != null)
		{
			<span class="validation-message">@_errorMessage</span>
		}
		<button class="w-100 mt-2 btn btn-primary" type="submit">
			@Resource.Submit
		</button>
	</EditForm>
</div>
